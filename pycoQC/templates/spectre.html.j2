<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>{{ report_title }}</title>

    <!-- Styles and the plotting library are embedded rather than fetched, so
         the report keeps working offline and years from now, when the CDN has
         moved on. Spectre.css is MIT licensed, see templates/vendor. -->
    <style>{{ spectre_css }}</style>
    <script>{{ plotlyjs }}</script>
    <style>
    	.tf {
    		position: fixed;
    		top: 0;
    		left: 50%;
    		transform: translateX(-50%);
		z-index: 99 !important;
    	}
    	.report-logo { width: 420px; max-width: 80%; margin-bottom: 10px; }
    	.meta-row { margin-bottom: 6px; }
    	.meta-card {
    		border: 1px solid #e7e9ed;
    		border-radius: 8px;
    		padding: 10px 16px 4px 16px;
    		height: 100%;
    	}
    	.meta-head {
    		margin: 0 0 6px 0;
    		font-size: .62rem;
    		letter-spacing: .09rem;
    		text-transform: uppercase;
    		color: #90a0b0;
    	}
    	.meta-table th {
    		width: 42%;
    		font-weight: 600;
    		color: #66758c;
    		white-space: nowrap;
    	}
    	.meta-table td { color: #3b4351; word-break: break-word; }
    	.meta-table th, .meta-table td {
    		padding: 4px 6px;
    		font-size: .72rem;
    		border-bottom: none;
    	}
    </style>
  </head>
<body>

<div class="container">
	<div class="columns">
		<div class="column col-12 col-mx-auto tf">
			<header class="navbar">
				<section class="navbar-section">
    	    				<a href="https://github.com/duceppemo/pycoqc-ng" class="navbar-brand mr-2" target="_blank">pycoqc-ng</a>
    	    				<a href="https://github.com/duceppemo/pycoqc-ng#usage" class="btn btn-link" target="_blank">Docs</a>
    	    				<a href="https://github.com/duceppemo/pycoqc-ng" class="btn btn-link" target="_blank">GitHub</a>
	  			</section>
  	  			<section class="navbar-section">
					<div class="dropdown dropdown-right">
						<a href="#/" class="btn btn-link dropdown-toggle" tabindex="0">Menu <i class="icon icon-menu"></i></a>
						<ul class="menu">
							<li class="menu-item">
								{% for item in titles%}
								<a href="#{{ item }}">{{ item }}</a>
								{% endfor %}
							</li>
						</ul>
					</div>
				</section>
			</header>
      		</div>
	</div>
	<div class="columns">

		<div class="column col-9 col-mx-auto">
			<div class="text-center" style="margin-top: 70px;">
				{% if logo_url %}
				<img src="{{ logo_url }}" alt="pycoqc-ng" class="report-logo">
				{% endif %}
				<h1 style="margin-bottom: 4px;">{{ report_title }}</h1>
				<p class="text-gray" style="margin-bottom: 22px;">{{ report_subtitle }}</p>
			</div>

			{% if run_meta or report_meta %}
			<div class="columns meta-row">
				{% set meta_cols = "col-6" if run_meta and report_meta else "col-6 col-mx-auto" %}
				{% if run_meta %}
				<div class="column {{ meta_cols }} col-sm-12">
					<div class="meta-card">
						<h5 class="meta-head">Sequencing run</h5>
						<table class="table table-striped meta-table">
							{% for key, value in run_meta.items() %}
							<tr><th>{{ key }}</th><td>{{ value }}</td></tr>
							{% endfor %}
						</table>
					</div>
				</div>
				{% endif %}
				{% if report_meta %}
				<div class="column {{ meta_cols }} col-sm-12">
					<div class="meta-card">
						<h5 class="meta-head">Report</h5>
						<table class="table table-striped meta-table">
							{% for key, value in report_meta.items() %}
							<tr><th>{{ key }}</th><td>{{ value }}</td></tr>
							{% endfor %}
						</table>
					</div>
				</div>
				{% endif %}
			</div>
			{% endif %}
			<div class="divider"></div>
			<div class="columns">
				{% for item in plots %}
					<div id="{{ titles[loop.index0] }}" class="column col-11 col-mx-auto text-center">
						<h4 style="margin-top: 50px;">{{ titles[loop.index0] }}</h4>
						{{ item }}
						<div class="divider"></div>
					</div>
				{% endfor %}
			</div>
            <div class="text-left">
                {{ src_files }}
            </div>
		</div>
    </div>
</div>
</body>
</html>
